@model Genero

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. Rol (RPG)" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="Popular" class="form-check-input" role="switch" />
            <label asp-for="Popular" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"
                  placeholder="Características principales del género"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
</div>
