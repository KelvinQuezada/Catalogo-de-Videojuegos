@model IEnumerable<Videojuego>

@{
    ViewData["Title"] = "Videojuegos";
    var buscar = ViewData["Buscar"] as string;
}

<div class="page-header">
    <h1>Videojuegos</h1>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo videojuego</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="buscar" value="@buscar" class="form-control" placeholder="Buscar por título..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<div class="table-card table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Género</th>
                <th>Desarrolladora</th>
                <th class="text-end">Precio</th>
                <th>Lanzamiento</th>
                <th>Plataformas</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-4">No se encontraron videojuegos.</td>
            </tr>
        }
        @foreach (var v in Model)
        {
            <tr>
                <td>
                    <a class="text-decoration-none fw-medium" asp-action="Details" asp-route-id="@v.Id">@v.Titulo</a>
                    @if (v.Multijugador)
                    {
                        <span class="badge bg-info-subtle text-info-emphasis ms-1">Multijugador</span>
                    }
                </td>
                <td>@v.Genero?.Nombre</td>
                <td>@v.Desarrolladora?.Nombre</td>
                <td class="text-end text-nowrap">@v.Precio.ToString("0.00") USD</td>
                <td class="text-nowrap">@v.FechaLanzamiento.ToString("dd/MM/yyyy")</td>
                <td>
                    @foreach (var plataforma in v.Plataformas)
                    {
                        <span class="badge badge-plataforma">@plataforma.Nombre</span>
                    }
                </td>
                <td>
                    @if (v.Disponible)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">No disponible</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@v.Id">Ver</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@v.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.Id">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<p class="text-muted small mt-3">Total de registros mostrados: @Model.Count()</p>
