@model CatalogoVideojuegos.ViewModels.VideojuegoFormViewModel

@{
    ViewData["Title"] = "Editar videojuego";
}

<div class="page-header">
    <h1>Editar videojuego</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Videojuego.Id" method="post">
        <input type="hidden" asp-for="Videojuego.Id" />
        <input type="hidden" asp-for="Videojuego.FechaRegistro" />
        <partial name="_Formulario" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Videojuego.Id">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
