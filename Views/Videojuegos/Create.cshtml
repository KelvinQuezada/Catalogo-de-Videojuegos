@model CatalogoVideojuegos.ViewModels.VideojuegoFormViewModel

@{
    ViewData["Title"] = "Nuevo videojuego";
}

<div class="page-header">
    <h1>Nuevo videojuego</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        <partial name="_Formulario" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar videojuego</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
