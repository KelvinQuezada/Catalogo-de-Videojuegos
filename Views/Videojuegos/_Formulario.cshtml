@model CatalogoVideojuegos.ViewModels.VideojuegoFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="mb-3">
            <label asp-for="Videojuego.Titulo" class="form-label"></label>
            <input asp-for="Videojuego.Titulo" class="form-control" placeholder="Ej. The Legend of Zelda: Breath of the Wild" />
            <span asp-validation-for="Videojuego.Titulo" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Videojuego.Descripcion" class="form-label"></label>
            <textarea asp-for="Videojuego.Descripcion" class="form-control" rows="3"
                      placeholder="Descripción breve del videojuego"></textarea>
            <span asp-validation-for="Videojuego.Descripcion" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Videojuego.GeneroId" class="form-label"></label>
                <select asp-for="Videojuego.GeneroId" asp-items="Model.Generos" class="form-select">
                    <option value="">-- Seleccione un género --</option>
                </select>
                <span asp-validation-for="Videojuego.GeneroId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Videojuego.DesarrolladoraId" class="form-label"></label>
                <select asp-for="Videojuego.DesarrolladoraId" asp-items="Model.Desarrolladoras" class="form-select">
                    <option value="">-- Seleccione una desarrolladora --</option>
                </select>
                <span asp-validation-for="Videojuego.DesarrolladoraId" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label asp-for="Videojuego.Precio" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">USD</span>
                    <input asp-for="Videojuego.Precio" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <span asp-validation-for="Videojuego.Precio" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Videojuego.FechaLanzamiento" class="form-label"></label>
                <input asp-for="Videojuego.FechaLanzamiento" type="date" class="form-control" />
                <span asp-validation-for="Videojuego.FechaLanzamiento" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Videojuego.CantidadJugadores" class="form-label"></label>
                <input asp-for="Videojuego.CantidadJugadores" type="number" min="1" max="8" class="form-control" />
                <span asp-validation-for="Videojuego.CantidadJugadores" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label asp-for="Videojuego.ClasificacionPorEdad" class="form-label"></label>
                <select asp-for="Videojuego.ClasificacionPorEdad" class="form-select">
                    <option value="">-- Sin clasificar --</option>
                    <option value="E">E · Todos</option>
                    <option value="E10+">E10+ · Mayores de 10</option>
                    <option value="T">T · Adolescentes</option>
                    <option value="M">M · Adultos</option>
                    <option value="RP">RP · Sin clasificar</option>
                </select>
                <span asp-validation-for="Videojuego.ClasificacionPorEdad" class="text-danger small"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch me-4">
                    <input asp-for="Videojuego.Disponible" class="form-check-input" role="switch" />
                    <label asp-for="Videojuego.Disponible" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="Videojuego.Multijugador" class="form-check-input" role="switch" />
                    <label asp-for="Videojuego.Multijugador" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Videojuego.Observacion" class="form-label"></label>
            <textarea asp-for="Videojuego.Observacion" class="form-control" rows="2"
                      placeholder="Observaciones internas del catálogo (opcional)"></textarea>
            <span asp-validation-for="Videojuego.Observacion" class="text-danger small"></span>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="border rounded-3 p-3 bg-light-subtle">
            <label class="form-label fw-semibold">Plataformas disponibles</label>
            <p class="text-muted small mb-2">
                Relación muchos a muchos: un videojuego puede estar en varias plataformas.
            </p>
            <div class="lista-plataformas">
                @foreach (var plataforma in Model.Plataformas)
                {
                    var marcada = Model.PlataformasSeleccionadas.Contains(int.Parse(plataforma.Value));
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="PlataformasSeleccionadas"
                               value="@plataforma.Value" id="plataforma_@plataforma.Value" checked="@marcada" />
                        <label class="form-check-label" for="plataforma_@plataforma.Value">@plataforma.Text</label>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
