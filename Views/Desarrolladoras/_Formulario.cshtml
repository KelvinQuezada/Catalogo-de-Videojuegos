@model Desarrolladora

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. FromSoftware" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Pais" class="form-label"></label>
        <input asp-for="Pais" class="form-control" placeholder="Ej. Japón" />
        <span asp-validation-for="Pais" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Fundacion" class="form-label"></label>
        <input asp-for="Fundacion" type="date" class="form-control" />
        <span asp-validation-for="Fundacion" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Empleados" class="form-label"></label>
        <input asp-for="Empleados" type="number" min="1" max="50000" class="form-control" />
        <span asp-validation-for="Empleados" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input asp-for="Activa" class="form-check-input" role="switch" />
            <label asp-for="Activa" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="SitioWeb" class="form-label"></label>
        <input asp-for="SitioWeb" type="url" class="form-control" placeholder="https://..." />
        <span asp-validation-for="SitioWeb" class="text-danger small"></span>
    </div>
</div>
