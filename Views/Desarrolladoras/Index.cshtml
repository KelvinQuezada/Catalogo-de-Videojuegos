@model IEnumerable<Desarrolladora>

@{
    ViewData["Title"] = "Desarrolladoras";
}

<div class="page-header">
    <h1>Desarrolladoras</h1>
    <a class="btn btn-primary" asp-action="Create">+ Nueva desarrolladora</a>
</div>

<div class="table-card table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>País</th>
                <th>Fundación</th>
                <th class="text-end">Empleados</th>
                <th class="text-center">Videojuegos</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>
                    <a class="text-decoration-none fw-medium" asp-action="Details" asp-route-id="@d.Id">@d.Nombre</a>
                </td>
                <td>@d.Pais</td>
                <td class="text-nowrap">@(d.Fundacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                <td class="text-end">@(d.Empleados?.ToString("N0") ?? "-")</td>
                <td class="text-center">
                    <span class="badge bg-primary rounded-pill">@d.Videojuegos.Count</span>
                </td>
                <td>
                    @if (d.Activa)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Inactiva</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@d.Id">Ver</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.Id">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<p class="text-muted small mt-3">Total de desarrolladoras: @Model.Count()</p>
